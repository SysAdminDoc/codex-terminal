{
  "name": "codex-terminal",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "l10n": "./l10n",
  "version": "0.2.0",
  "publisher": "sysadmindoc",
  "license": "MIT",
  "author": "SysAdminDoc",
  "repository": {
    "type": "git",
    "url": "https://github.com/SysAdminDoc/codex-terminal.git"
  },
  "bugs": {
    "url": "https://github.com/SysAdminDoc/codex-terminal/issues"
  },
  "homepage": "https://github.com/SysAdminDoc/codex-terminal#readme",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#11111b",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "codex",
    "cli",
    "terminal",
    "powershell",
    "agent"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexTerminalContainer",
          "title": "%views.container.title%",
          "icon": "resources/activity-icon.svg"
        }
      ]
    },
    "views": {
      "codexTerminalContainer": [
        {
          "id": "codexTerminal.actions",
          "name": "%views.launch.name%",
          "icon": "resources/activity-icon.svg"
        }
      ]
    },
    "terminal": {
      "profiles": [
        {
          "id": "codexTerminal.profile",
          "title": "%terminal.profile.title%",
          "icon": "sparkle"
        }
      ]
    },
    "commands": [
      {
        "command": "codexTerminal.new",
        "title": "%command.new.title%",
        "category": "%category.codexTerminal%",
        "icon": "$(sparkle)"
      },
      {
        "command": "codexTerminal.newWithProfile",
        "title": "%command.newWithProfile.title%",
        "category": "%category.codexTerminal%"
      },
      {
        "command": "codexTerminal.resumeLast",
        "title": "%command.resumeLast.title%",
        "category": "%category.codexTerminal%"
      },
      {
        "command": "codexTerminal.resumePicker",
        "title": "%command.resumePicker.title%",
        "category": "%category.codexTerminal%"
      },
      {
        "command": "codexTerminal.forkLast",
        "title": "%command.forkLast.title%",
        "category": "%category.codexTerminal%"
      },
      {
        "command": "codexTerminal.focus",
        "title": "%command.focus.title%",
        "category": "%category.codexTerminal%"
      },
      {
        "command": "codexTerminal.sendFileReference",
        "title": "%command.sendReference.title%",
        "category": "%category.codexTerminal%"
      },
      {
        "command": "codexTerminal.doctor",
        "title": "%command.doctor.title%",
        "category": "%category.codexTerminal%"
      },
      {
        "command": "codexTerminal.focusSession",
        "title": "%command.focusSession.title%",
        "category": "%category.codexTerminal%",
        "icon": "$(terminal)"
      },
      {
        "command": "codexTerminal.stopSession",
        "title": "%command.stopSession.title%",
        "category": "%category.codexTerminal%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "codexTerminal.showLog",
        "title": "%command.showLog.title%",
        "category": "%category.codexTerminal%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codexTerminal.new",
          "when": "view == codexTerminal.actions",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "codexTerminal.new",
          "group": "navigation@100",
          "when": "config.codexTerminal.showEditorTitleButton"
        }
      ],
      "editor/context": [
        {
          "command": "codexTerminal.sendFileReference",
          "group": "codexTerminal@1",
          "when": "resourceScheme == file"
        }
      ],
      "view/item/context": [
        {
          "command": "codexTerminal.focusSession",
          "when": "view == codexTerminal.actions && viewItem == codexTerminal.runningSession",
          "group": "inline@1"
        },
        {
          "command": "codexTerminal.stopSession",
          "when": "view == codexTerminal.actions && viewItem == codexTerminal.runningSession",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "codexTerminal.shell": {
          "type": "string",
          "enum": [
            "auto",
            "pwsh",
            "powershell",
            "cmd",
            "bash",
            "zsh",
            "custom",
            "editorDefault"
          ],
          "enumDescriptions": [
            "%setting.shell.auto%",
            "%setting.shell.pwsh%",
            "%setting.shell.powershell%",
            "%setting.shell.cmd%",
            "%setting.shell.bash%",
            "%setting.shell.zsh%",
            "%setting.shell.custom%",
            "%setting.shell.editorDefault%"
          ],
          "default": "auto",
          "markdownDescription": "%setting.shell.markdownDescription%",
          "scope": "machine-overridable"
        },
        "codexTerminal.customShellPath": {
          "type": "string",
          "default": "",
          "description": "%setting.customShellPath.description%",
          "scope": "machine-overridable"
        },
        "codexTerminal.command": {
          "type": "string",
          "default": "codex",
          "description": "%setting.command.description%",
          "scope": "machine-overridable"
        },
        "codexTerminal.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%setting.args.description%",
          "scope": "machine-overridable"
        },
        "codexTerminal.keepShellOpen": {
          "type": "boolean",
          "default": true,
          "description": "%setting.keepShellOpen.description%",
          "scope": "machine-overridable"
        },
        "codexTerminal.location": {
          "type": "string",
          "enum": [
            "editor",
            "editorBeside",
            "panel"
          ],
          "default": "editor",
          "enumDescriptions": [
            "%setting.location.editor%",
            "%setting.location.editorBeside%",
            "%setting.location.panel%"
          ],
          "description": "%setting.location.description%"
        },
        "codexTerminal.reuseTerminal": {
          "type": "boolean",
          "default": false,
          "description": "%setting.reuseTerminal.description%"
        },
        "codexTerminal.cwd": {
          "type": "string",
          "enum": [
            "activeFileFolder",
            "activeFileWorkspaceFolder",
            "firstWorkspaceFolder",
            "prompt"
          ],
          "default": "activeFileWorkspaceFolder",
          "enumDescriptions": [
            "%setting.cwd.activeFileFolder%",
            "%setting.cwd.activeFileWorkspaceFolder%",
            "%setting.cwd.firstWorkspaceFolder%",
            "%setting.cwd.prompt%"
          ],
          "description": "%setting.cwd.description%"
        },
        "codexTerminal.env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "%setting.env.description%",
          "scope": "machine-overridable"
        },
        "codexTerminal.terminalName": {
          "type": "string",
          "default": "Codex",
          "description": "%setting.terminalName.description%"
        },
        "codexTerminal.iconColor": {
          "type": "string",
          "default": "terminal.ansiMagenta",
          "description": "%setting.iconColor.description%"
        },
        "codexTerminal.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "%setting.showStatusBarItem.description%"
        },
        "codexTerminal.showEditorTitleButton": {
          "type": "boolean",
          "default": true,
          "description": "%setting.showEditorTitleButton.description%"
        },
        "codexTerminal.notifyOnCompletion": {
          "type": "boolean",
          "default": false,
          "description": "%setting.notifyOnCompletion.description%",
          "scope": "machine-overridable"
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('out',{recursive:true,force:true})\"",
    "compile": "tsc -p tsconfig.json",
    "bundle": "node esbuild.mjs",
    "lint": "eslint src --ext ts",
    "l10n:export": "vscode-l10n-dev export -o l10n ./src",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "test:integration": "npm run compile && npm run bundle && vscode-test --label hostile --jobs 1",
    "check": "npm run clean && npm run compile && npm run lint && node --test \"out/test/*.test.js\" && npm run bundle",
    "package": "npm run check && vsce package --out dist/codex-terminal-0.2.0.vsix",
    "vscode:prepublish": "npm run clean && npm run bundle"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
