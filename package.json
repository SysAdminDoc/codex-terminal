{
  "name": "codex-terminal",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "l10n": "./l10n",
  "version": "0.7.0",
  "publisher": "sysadmindoc",
  "license": "MIT",
  "author": "SysAdminDoc",
  "repository": {
    "type": "git",
    "url": "https://github.com/SysAdminDoc/codex-terminal.git"
  },
  "bugs": {
    "url": "https://github.com/SysAdminDoc/codex-terminal/issues"
  },
  "homepage": "https://github.com/SysAdminDoc/codex-terminal#readme",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#11111b",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "codex",
    "cli",
    "terminal",
    "powershell",
    "agent"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexTerminalContainer",
          "title": "%views.container.title%",
          "icon": "resources/activity-icon.svg"
        }
      ]
    },
    "views": {
      "codexTerminalContainer": [
        {
          "id": "codexTerminal.actions",
          "name": "%views.launch.name%",
          "icon": "resources/activity-icon.svg"
        },
        {
          "id": "codexTerminal.history",
          "name": "%views.history.name%",
          "icon": "$(history)"
        }
      ]
    },
    "terminal": {
      "profiles": [
        {
          "id": "codexTerminal.profile",
          "title": "%terminal.profile.title%",
          "icon": "sparkle",
          "titleTemplate": "${sequence}"
        }
      ]
    },
    "commands": [
      {
        "command": "codexTerminal.new",
        "title": "%command.new.title%",
        "category": "%category.codexTerminal%",
        "icon": "$(sparkle)"
      },
      {
        "command": "codexTerminal.newWithProfile",
        "title": "%command.newWithProfile.title%",
        "category": "%category.codexTerminal%"
      },
      {
        "command": "codexTerminal.resumeLast",
        "title": "%command.resumeLast.title%",
        "category": "%category.codexTerminal%"
      },
      {
        "command": "codexTerminal.resumePicker",
        "title": "%command.resumePicker.title%",
        "category": "%category.codexTerminal%"
      },
      {
        "command": "codexTerminal.forkLast",
        "title": "%command.forkLast.title%",
        "category": "%category.codexTerminal%"
      },
      {
        "command": "codexTerminal.focus",
        "title": "%command.focus.title%",
        "category": "%category.codexTerminal%"
      },
      {
        "command": "codexTerminal.sendFileReference",
        "title": "%command.sendReference.title%",
        "category": "%category.codexTerminal%"
      },
      {
        "command": "codexTerminal.askAboutSelection",
        "title": "%command.askAboutSelection.title%",
        "category": "%category.codexTerminal%"
      },
      {
        "command": "codexTerminal.checkAppServer",
        "title": "%command.checkAppServer.title%",
        "category": "%category.codexTerminal%"
      },
      {
        "command": "codexTerminal.doctor",
        "title": "%command.doctor.title%",
        "category": "%category.codexTerminal%"
      },
      {
        "command": "codexTerminal.focusSession",
        "title": "%command.focusSession.title%",
        "category": "%category.codexTerminal%",
        "icon": "$(terminal)"
      },
      {
        "command": "codexTerminal.stopSession",
        "title": "%command.stopSession.title%",
        "category": "%category.codexTerminal%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "codexTerminal.revertWorkbenchSettings",
        "title": "%command.revertWorkbenchSettings.title%",
        "category": "%category.codexTerminal%"
      },
      {
        "command": "codexTerminal.showLog",
        "title": "%command.showLog.title%",
        "category": "%category.codexTerminal%"
      },
      {
        "command": "codexTerminal.refreshHistory",
        "title": "%command.refreshHistory.title%",
        "category": "%category.codexTerminal%",
        "icon": "$(refresh)"
      },
      {
        "command": "codexTerminal.searchHistory",
        "title": "%command.searchHistory.title%",
        "category": "%category.codexTerminal%",
        "icon": "$(search)"
      },
      {
        "command": "codexTerminal.openTranscript",
        "title": "%command.openTranscript.title%",
        "category": "%category.codexTerminal%",
        "icon": "$(book)"
      },
      {
        "command": "codexTerminal.resumeHistorySession",
        "title": "%command.resumeHistory.title%",
        "category": "%category.codexTerminal%",
        "icon": "$(debug-start)"
      },
      {
        "command": "codexTerminal.copyHistorySessionId",
        "title": "%command.copyHistoryId.title%",
        "category": "%category.codexTerminal%",
        "icon": "$(copy)"
      },
      {
        "command": "codexTerminal.openRawHistorySession",
        "title": "%command.openRawHistory.title%",
        "category": "%category.codexTerminal%"
      },
      {
        "command": "codexTerminal.restoreSession",
        "title": "%command.restoreSession.title%",
        "category": "%category.codexTerminal%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "codexTerminal.restoreAllSessions",
        "title": "%command.restoreAllSessions.title%",
        "category": "%category.codexTerminal%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "codexTerminal.dismissRecovery",
        "title": "%command.dismissRecovery.title%",
        "category": "%category.codexTerminal%",
        "icon": "$(close)"
      },
      {
        "command": "codexTerminal.archiveSession",
        "title": "%command.archiveSession.title%",
        "category": "%category.codexTerminal%",
        "icon": "$(archive)"
      },
      {
        "command": "codexTerminal.deleteSession",
        "title": "%command.deleteSession.title%",
        "category": "%category.codexTerminal%",
        "icon": "$(trash)"
      },
      {
        "command": "codexTerminal.forkHistorySession",
        "title": "%command.forkHistory.title%",
        "category": "%category.codexTerminal%",
        "icon": "$(git-branch)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codexTerminal.new",
          "when": "view == codexTerminal.actions",
          "group": "navigation@1"
        },
        {
          "command": "codexTerminal.refreshHistory",
          "when": "view == codexTerminal.history",
          "group": "navigation@1"
        },
        {
          "command": "codexTerminal.searchHistory",
          "when": "view == codexTerminal.history",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "codexTerminal.new",
          "group": "navigation@100",
          "when": "config.codexTerminal.showEditorTitleButton"
        }
      ],
      "editor/context": [
        {
          "command": "codexTerminal.sendFileReference",
          "group": "codexTerminal@1",
          "when": "resourceScheme == file"
        },
        {
          "command": "codexTerminal.askAboutSelection",
          "group": "codexTerminal@2",
          "when": "resourceScheme == file"
        }
      ],
      "view/item/context": [
        {
          "command": "codexTerminal.focusSession",
          "when": "view == codexTerminal.actions && viewItem =~ /^codexTerminal\\.runningSession/",
          "group": "inline@1"
        },
        {
          "command": "codexTerminal.stopSession",
          "when": "view == codexTerminal.actions && viewItem =~ /^codexTerminal\\.runningSession/",
          "group": "inline@2"
        },
        {
          "command": "codexTerminal.nameSession",
          "when": "view == codexTerminal.actions && viewItem == codexTerminal.runningSession.bound",
          "group": "codexTerminal@1"
        },
        {
          "command": "codexTerminal.nameSession",
          "when": "view == codexTerminal.history && viewItem == codexTerminal.historySession",
          "group": "codexTerminal@0"
        },
        {
          "command": "codexTerminal.openTranscript",
          "when": "view == codexTerminal.history && viewItem == codexTerminal.historySession",
          "group": "inline@1"
        },
        {
          "command": "codexTerminal.copyHistorySessionId",
          "when": "view == codexTerminal.history && viewItem == codexTerminal.historySession",
          "group": "inline@2"
        },
        {
          "command": "codexTerminal.resumeHistorySession",
          "when": "view == codexTerminal.history && viewItem == codexTerminal.historySession",
          "group": "codexTerminal@1"
        },
        {
          "command": "codexTerminal.openRawHistorySession",
          "when": "view == codexTerminal.history && viewItem == codexTerminal.historySession",
          "group": "codexTerminal@2"
        },
        {
          "command": "codexTerminal.restoreSession",
          "when": "view == codexTerminal.history && viewItem == codexTerminal.recoverySession",
          "group": "inline@1"
        },
        {
          "command": "codexTerminal.restoreAllSessions",
          "when": "view == codexTerminal.history && viewItem == codexTerminal.recoveryGroup",
          "group": "inline@1"
        },
        {
          "command": "codexTerminal.dismissRecovery",
          "when": "view == codexTerminal.history && viewItem == codexTerminal.recoveryGroup",
          "group": "inline@2"
        },
        {
          "command": "codexTerminal.archiveSession",
          "when": "view == codexTerminal.history && viewItem == codexTerminal.historySession",
          "group": "codexTerminal@3"
        },
        {
          "command": "codexTerminal.deleteSession",
          "when": "view == codexTerminal.history && viewItem == codexTerminal.historySession",
          "group": "codexTerminal@4"
        },
        {
          "command": "codexTerminal.forkHistorySession",
          "when": "view == codexTerminal.history && viewItem == codexTerminal.historySession",
          "group": "codexTerminal@2"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "codexTerminal.shell": {
          "type": "string",
          "enum": [
            "auto",
            "pwsh",
            "powershell",
            "cmd",
            "bash",
            "zsh",
            "custom",
            "editorDefault"
          ],
          "enumDescriptions": [
            "%setting.shell.auto%",
            "%setting.shell.pwsh%",
            "%setting.shell.powershell%",
            "%setting.shell.cmd%",
            "%setting.shell.bash%",
            "%setting.shell.zsh%",
            "%setting.shell.custom%",
            "%setting.shell.editorDefault%"
          ],
          "default": "auto",
          "markdownDescription": "%setting.shell.markdownDescription%",
          "scope": "machine-overridable"
        },
        "codexTerminal.customShellPath": {
          "type": "string",
          "default": "",
          "description": "%setting.customShellPath.description%",
          "scope": "machine-overridable"
        },
        "codexTerminal.command": {
          "type": "string",
          "default": "codex",
          "description": "%setting.command.description%",
          "scope": "machine-overridable"
        },
        "codexTerminal.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%setting.args.description%",
          "scope": "machine-overridable"
        },
        "codexTerminal.keepShellOpen": {
          "type": "boolean",
          "default": true,
          "description": "%setting.keepShellOpen.description%",
          "scope": "machine-overridable"
        },
        "codexTerminal.location": {
          "type": "string",
          "enum": [
            "editor",
            "editorBeside",
            "panel"
          ],
          "default": "editor",
          "enumDescriptions": [
            "%setting.location.editor%",
            "%setting.location.editorBeside%",
            "%setting.location.panel%"
          ],
          "description": "%setting.location.description%"
        },
        "codexTerminal.reuseTerminal": {
          "type": "boolean",
          "default": false,
          "description": "%setting.reuseTerminal.description%"
        },
        "codexTerminal.cwd": {
          "type": "string",
          "enum": [
            "activeFileFolder",
            "activeFileWorkspaceFolder",
            "firstWorkspaceFolder",
            "prompt"
          ],
          "default": "activeFileWorkspaceFolder",
          "enumDescriptions": [
            "%setting.cwd.activeFileFolder%",
            "%setting.cwd.activeFileWorkspaceFolder%",
            "%setting.cwd.firstWorkspaceFolder%",
            "%setting.cwd.prompt%"
          ],
          "description": "%setting.cwd.description%"
        },
        "codexTerminal.env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "%setting.env.description%",
          "scope": "machine-overridable"
        },
        "codexTerminal.terminalName": {
          "type": "string",
          "default": "Codex",
          "description": "%setting.terminalName.description%"
        },
        "codexTerminal.tabTitle": {
          "type": "string",
          "enum": [
            "live",
            "static"
          ],
          "default": "live",
          "enumDescriptions": [
            "%setting.tabTitle.live%",
            "%setting.tabTitle.static%"
          ],
          "markdownDescription": "%setting.tabTitle.markdownDescription%"
        },
        "codexTerminal.iconColor": {
          "type": "string",
          "default": "terminal.ansiMagenta",
          "description": "%setting.iconColor.description%"
        },
        "codexTerminal.showStatusBarButton": {
          "type": "boolean",
          "default": true,
          "description": "%setting.showStatusBarButton.description%"
        },
        "codexTerminal.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "%setting.showStatusBarItem.description%",
          "deprecationMessage": "%setting.showStatusBarItem.deprecation%"
        },
        "codexTerminal.showEditorTitleButton": {
          "type": "boolean",
          "default": true,
          "description": "%setting.showEditorTitleButton.description%"
        },
        "codexTerminal.showContextInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "%setting.showContextInStatusBar.description%"
        },
        "codexTerminal.stallSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 3600,
          "default": 45,
          "description": "%setting.stallSeconds.description%"
        },
        "codexTerminal.notifyOnCompletion": {
          "type": "boolean",
          "default": false,
          "description": "%setting.notifyOnCompletion.description%",
          "scope": "machine-overridable"
        },
        "codexTerminal.titleItems": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "default": [
            "activity",
            "project-name",
            "app-name"
          ],
          "description": "%setting.titleItems.description%",
          "scope": "machine-overridable"
        },
        "codexTerminal.appServer.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%setting.appServer.enabled.markdownDescription%",
          "tags": [
            "experimental"
          ]
        },
        "codexTerminal.monitor.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%setting.monitor.enabled.markdownDescription%"
        },
        "codexTerminal.journal.storeMessages": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%setting.journal.storeMessages.markdownDescription%"
        },
        "codexTerminal.transcript.includeToolCalls": {
          "type": "boolean",
          "default": true,
          "description": "%setting.transcript.includeToolCalls.description%"
        },
        "codexTerminal.transcript.includeToolOutput": {
          "type": "boolean",
          "default": false,
          "description": "%setting.transcript.includeToolOutput.description%"
        },
        "codexTerminal.history.maxSessions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 200,
          "description": "%setting.history.maxSessions.description%"
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('out',{recursive:true,force:true})\"",
    "compile": "tsc -p tsconfig.json",
    "bundle": "node esbuild.mjs",
    "lint": "eslint src",
    "l10n:export": "vscode-l10n-dev export -o l10n ./src",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "test:integration": "npm run compile && npm run bundle && vscode-test --label hostile --jobs 1",
    "check": "npm run clean && npm run compile && npm run lint && node --test \"out/test/*.test.js\" && npm run bundle",
    "package": "npm run check && node scripts/package.mjs",
    "vscode:prepublish": "npm run clean && npm run bundle"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "10.8.1",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces.description%",
      "restrictedConfigurations": [
        "codexTerminal.command",
        "codexTerminal.customShellPath",
        "codexTerminal.shell",
        "codexTerminal.args",
        "codexTerminal.env",
        "codexTerminal.titleItems"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces.description%"
    }
  },
  "extensionKind": [
    "workspace",
    "ui"
  ]
}
